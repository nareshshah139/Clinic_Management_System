digraph "cr33c-day-wise-summary" {
  graph [rankdir=LR, fontname="Helvetica", fontsize=13, labelloc=t, label="CR-33c Day-wise Summary\nstates 14/14 (100%) · transitions 30/30 (100%)", pad=0.3, nodesep=0.45, ranksep=0.7];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, penwidth=1.6];
  edge [fontname="Helvetica", fontsize=9, penwidth=1.4, arrowsize=0.7];
  __start [shape=point, width=0.15, label=""];
  __start -> "PurchasesHome";
  "PurchasesHome" [label="Inventory > Purchases, no report open", fillcolor="#d1fadf", color="#039855"];
  "Loaded" [label="Loaded: Sales, default range (month to date)", fillcolor="#d1fadf", color="#039855"];
  "Loading" [label="Loading (response held)", fillcolor="#d1fadf", color="#039855"];
  "LoadedRange" [label="Loaded: Sales, 3-4 Nov", fillcolor="#d1fadf", color="#039855"];
  "LoadedPurchase" [label="Loaded: Purchase type", fillcolor="#d1fadf", color="#039855"];
  "Empty" [label="Empty range (Download disabled)", fillcolor="#d1fadf", color="#039855"];
  "InvalidBlocked" [label="End before start: submit blocked, no request", fillcolor="#d1fadf", color="#039855"];
  "ErrorRange" [label="Range over 366 days: server error shown", fillcolor="#d1fadf", color="#039855"];
  "Forbidden" [label="RECEPTION: forbidden message", fillcolor="#d1fadf", color="#039855"];
  "HomeNoReportTasks" [label="RECEPTION: Purchases home, report tasks absent from menu", fillcolor="#d1fadf", color="#039855"];
  "LoadedOtherRole" [label="Loaded as DOCTOR / PHARMACIST", fillcolor="#d1fadf", color="#039855"];
  "TooltipOpen" [label="Bill No. (i) tooltip open", fillcolor="#d1fadf", color="#039855"];
  "ScrolledRight" [label="Scrolled right, left columns frozen", fillcolor="#d1fadf", color="#039855"];
  "Downloaded" [label="CSV downloaded and checked", fillcolor="#d1fadf", color="#039855"];
  "PurchasesHome" -> "Loaded" [label="More tasks > Day-wise summary ×5", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "PurchasesHome" [label="Purchases tab / address bar", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "Loading" [label="Go with the response held", color="#039855", fontcolor="#039855", style=solid];
  "Loading" -> "Loaded" [label="responseArrives", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "LoadedRange" [label="setNarrowRange ×2", color="#039855", fontcolor="#039855", style=solid];
  "LoadedRange" -> "Loaded" [label="resetRange", color="#039855", fontcolor="#039855", style=solid];
  "LoadedRange" -> "Loaded" [label="reload: range not persisted", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "LoadedPurchase" [label="typePurchase ×2", color="#039855", fontcolor="#039855", style=solid];
  "LoadedPurchase" -> "Loaded" [label="typeSales", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "Empty" [label="setEmptyRange", color="#039855", fontcolor="#039855", style=solid];
  "Empty" -> "Loaded" [label="resetRange", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "InvalidBlocked" [label="setBackwardsRange", color="#039855", fontcolor="#039855", style=solid];
  "InvalidBlocked" -> "Loaded" [label="resetRange", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "ErrorRange" [label="setTooLongRange", color="#039855", fontcolor="#039855", style=solid];
  "ErrorRange" -> "Loaded" [label="resetRange", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "Forbidden" [label="switchReception ×2", color="#039855", fontcolor="#039855", style=solid];
  "Forbidden" -> "Loaded" [label="switchAdmin", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "HomeNoReportTasks" [label="switchReceptionHome", color="#039855", fontcolor="#039855", style=solid];
  "HomeNoReportTasks" -> "PurchasesHome" [label="switchAdminHome", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "LoadedOtherRole" [label="switchAccountant", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "LoadedOtherRole" [label="switchDoctor", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "LoadedOtherRole" [label="switchPharmacist", color="#039855", fontcolor="#039855", style=solid];
  "LoadedOtherRole" -> "Loaded" [label="switchAdmin ×3", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "TooltipOpen" [label="hoverBillNoTip", color="#039855", fontcolor="#039855", style=solid];
  "TooltipOpen" -> "Loaded" [label="moveAway", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "ScrolledRight" [label="scrollRight", color="#039855", fontcolor="#039855", style=solid];
  "ScrolledRight" -> "Loaded" [label="scrollLeft", color="#039855", fontcolor="#039855", style=solid];
  "Loaded" -> "Downloaded" [label="download", color="#039855", fontcolor="#039855", style=solid];
  "LoadedPurchase" -> "Downloaded" [label="download", color="#039855", fontcolor="#039855", style=solid];
  "Downloaded" -> "Loaded" [label="reload ×2", color="#039855", fontcolor="#039855", style=solid];
}