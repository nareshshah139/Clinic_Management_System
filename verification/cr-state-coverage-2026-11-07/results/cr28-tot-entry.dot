digraph "cr28-tot-entry" {
  graph [rankdir=LR, fontname="Helvetica", fontsize=13, labelloc=t, label="CR-28 Terms of Trade: doctor entry, edit, delete, persistence\nstates 27/27 (100%) · transitions 38/38 (100%)", pad=0.3, nodesep=0.45, ranksep=0.7];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, penwidth=1.6];
  edge [fontname="Helvetica", fontsize=9, penwidth=1.4, arrowsize=0.7];
  __start [shape=point, width=0.15, label=""];
  __start -> "List";
  "List" [label="Distributor list", fillcolor="#d1fadf", color="#039855"];
  "ListByName" [label="Search by name", fillcolor="#d1fadf", color="#039855"];
  "ListByGstin" [label="Search by GSTIN", fillcolor="#d1fadf", color="#039855"];
  "ListNone" [label="Search, no results", fillcolor="#d1fadf", color="#039855"];
  "DetailEmpty" [label="Distributor selected, no terms", fillcolor="#d1fadf", color="#039855"];
  "W1" [label="Step 1 Distributor, none chosen", fillcolor="#d1fadf", color="#039855"];
  "W1Chosen" [label="Step 1, distributor chosen", fillcolor="#d1fadf", color="#039855"];
  "W2" [label="Step 2 Items, none", fillcolor="#d1fadf", color="#039855"];
  "W2Picked" [label="Step 2, one product", fillcolor="#d1fadf", color="#039855"];
  "W2Two" [label="Step 2, two products", fillcolor="#d1fadf", color="#039855"];
  "W3" [label="Step 3 Scheme, empty", fillcolor="#d1fadf", color="#039855"];
  "W3BadDiscount" [label="Step 3, discount over 100", fillcolor="#d1fadf", color="#039855"];
  "W3BuyOnly" [label="Step 3, scheme buy without free", fillcolor="#d1fadf", color="#039855"];
  "W3Ready" [label="Step 3, valid", fillcolor="#d1fadf", color="#039855"];
  "Review" [label="Review", fillcolor="#d1fadf", color="#039855"];
  "Saved" [label="Saved, rows by NAME on DATE", fillcolor="#d1fadf", color="#039855"];
  "EditForm" [label="Edit one product", fillcolor="#d1fadf", color="#039855"];
  "DeleteConfirm" [label="Delete asks to confirm", fillcolor="#d1fadf", color="#039855"];
  "Deleted" [label="Row deleted", fillcolor="#d1fadf", color="#039855", peripheries=2];
  "ListPersisted" [label="List after reload with recent shortlist", fillcolor="#d1fadf", color="#039855"];
  "Cancelled" [label="Wizard cancelled, nothing saved", fillcolor="#d1fadf", color="#039855", peripheries=2];
  "R2" [label="Re-save: step 2 for saved distributor", fillcolor="#d1fadf", color="#039855"];
  "R2Picked" [label="Re-save: Dolo picked again", fillcolor="#d1fadf", color="#039855"];
  "R3" [label="Re-save: step 3", fillcolor="#d1fadf", color="#039855"];
  "R3Ready" [label="Re-save: step 3 valid", fillcolor="#d1fadf", color="#039855"];
  "RReview" [label="Re-save: review", fillcolor="#d1fadf", color="#039855"];
  "SavedResaved" [label="Re-saved: still one row per product", fillcolor="#d1fadf", color="#039855", peripheries=2];
  "List" -> "ListByName" [label="searchName", color="#039855", fontcolor="#039855", style=solid];
  "List" -> "ListByGstin" [label="searchGstin", color="#039855", fontcolor="#039855", style=solid];
  "List" -> "ListNone" [label="searchNothing", color="#039855", fontcolor="#039855", style=solid];
  "ListByName" -> "DetailEmpty" [label="openFound", color="#039855", fontcolor="#039855", style=solid];
  "List" -> "DetailEmpty" [label="openDistributor ×5", color="#039855", fontcolor="#039855", style=solid];
  "DetailEmpty" -> "List" [label="allDistributors", color="#039855", fontcolor="#039855", style=solid];
  "DetailEmpty" -> "W2" [label="addTerms ×5", color="#039855", fontcolor="#039855", style=solid];
  "List" -> "W1" [label="addTerms ×2", color="#039855", fontcolor="#039855", style=solid];
  "W1" -> "W1Chosen" [label="chooseDistributor", color="#039855", fontcolor="#039855", style=solid];
  "W1" -> "Cancelled" [label="cancel", color="#039855", fontcolor="#039855", style=solid];
  "W1Chosen" -> "W2" [label="next ×2", color="#039855", fontcolor="#039855", style=solid];
  "W2" -> "W1Chosen" [label="back", color="#039855", fontcolor="#039855", style=solid];
  "W2" -> "W2Picked" [label="addProduct ×6", color="#039855", fontcolor="#039855", style=solid];
  "W2Picked" -> "W2Two" [label="addSecondProduct ×7", color="#039855", fontcolor="#039855", style=solid];
  "W2Two" -> "W2Picked" [label="removeSecond", color="#039855", fontcolor="#039855", style=solid];
  "W2Two" -> "W3" [label="next ×7", color="#039855", fontcolor="#039855", style=solid];
  "W3" -> "W2Two" [label="back", color="#039855", fontcolor="#039855", style=solid];
