  "W3BadDiscount" -> "W3Ready" [label="fillValid ×5", color="#039855", fontcolor="#039855", style=solid];
  "W3BuyOnly" -> "W3Ready" [label="fillValid", color="#039855", fontcolor="#039855", style=solid];
  "W3Ready" -> "Review" [label="next ×6", color="#039855", fontcolor="#039855", style=solid];
  "Review" -> "W3Ready" [label="back", color="#039855", fontcolor="#039855", style=solid];
  "Review" -> "Cancelled" [label="cancel", color="#039855", fontcolor="#039855", style=solid];
  "Review" -> "Saved" [label="save ×4", color="#039855", fontcolor="#039855", style=solid];
  "Saved" -> "EditForm" [label="edit", color="#039855", fontcolor="#039855", style=solid];
  "EditForm" -> "Saved" [label="saveEdit", color="#039855", fontcolor="#039855", style=solid];
  "Saved" -> "DeleteConfirm" [label="delete", color="#039855", fontcolor="#039855", style=solid];
  "DeleteConfirm" -> "Deleted" [label="confirmDelete", color="#039855", fontcolor="#039855", style=solid];
  "Saved" -> "ListPersisted" [label="reload ×2", color="#039855", fontcolor="#039855", style=solid];
  "ListPersisted" -> "Saved" [label="openDistributor", color="#039855", fontcolor="#039855", style=solid];
  "ListPersisted" -> "Saved" [label="openRecent", color="#039855", fontcolor="#039855", style=solid];
  "Saved" -> "R2" [label="addTerms ×2", color="#039855", fontcolor="#039855", style=solid];
  "R2" -> "R2Picked" [label="addProduct ×2", color="#039855", fontcolor="#039855", style=solid];
  "R2Picked" -> "R3" [label="next ×2", color="#039855", fontcolor="#039855", style=solid];
  "R3" -> "R3Ready" [label="fillValid ×2", color="#039855", fontcolor="#039855", style=solid];
  "R3Ready" -> "RReview" [label="next ×2", color="#039855", fontcolor="#039855", style=solid];
  "RReview" -> "SavedResaved" [label="save", color="#039855", fontcolor="#039855", style=solid];
}