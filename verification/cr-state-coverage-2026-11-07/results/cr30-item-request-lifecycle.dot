digraph "cr30-item-request-lifecycle" {
  graph [rankdir=LR, fontname="Helvetica", fontsize=13, labelloc=t, label="CR-30 New item request: staff request -> doctor approve/reject -> inventory\nstates 33/33 (100%) · transitions 39/39 (100%)", pad=0.3, nodesep=0.45, ranksep=0.7];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, penwidth=1.6];
  edge [fontname="Helvetica", fontsize=9, penwidth=1.4, arrowsize=0.7];
  __start [shape=point, width=0.15, label=""];
  __start -> "StaffStock";
  "StaffStock" [label="Staff (reception) on stock list
new item absent", fillcolor="#d1fadf", color="#039855"];
  "StaffAddForm" [label="Staff: Add item form open", fillcolor="#d1fadf", color="#039855"];
  "StaffDuplicateSku" [label="Staff: duplicate SKU refused
(no request created)", fillcolor="#d1fadf", color="#039855"];
  "StaffDuplicateNameSubmitted" [label="Staff: sent for approval,
confirmation says item name
is already in inventory", fillcolor="#d1fadf", color="#039855"];
  "DoctorSeesDuplicateWarning" [label="Doctor card warns:
already in inventory +
also requested by", fillcolor="#d1fadf", color="#039855"];
  "DoctorSeesSkuCollision" [label="Doctor card warns:
SKU already used by an item", fillcolor="#d1fadf", color="#039855", peripheries=2];
  "StaffSubmitted" [label="Staff: 'Sent to doctor for approval'
request PENDING, 0 items", fillcolor="#d1fadf", color="#039855"];
  "StaffStockPending" [label="Staff stock search
item absent while pending", fillcolor="#d1fadf", color="#039855"];
  "StaffRequestsPending" [label="Staff 'My item requests'
Waiting for doctor", fillcolor="#d1fadf", color="#039855"];
  "StaffApproveForbidden" [label="Staff calls approve API
403, still PENDING", fillcolor="#d1fadf", color="#039855"];
  "StaffImportPending" [label="Staff opening-stock import
sent for approval, 0 items", fillcolor="#d1fadf", color="#039855"];
  "DoctorSeesPendingImport" [label="Doctor 'Opening stock imports'
rows previewed, badge counts it", fillcolor="#d1fadf", color="#039855"];
  "ImportRejectDialog" [label="Reject import dialog
no note: Reject disabled", fillcolor="#d1fadf", color="#039855"];
  "DoctorRejectedImport" [label="Doctor: import Rejected with note
0 items, badge -1", fillcolor="#d1fadf", color="#039855"];
  "StaffSeesImportRejected" [label="Staff 'My opening stock imports'
Rejected + note, 0 items", fillcolor="#d1fadf", color="#039855", peripheries=2];
  "DoctorApprovedImport" [label="Doctor: import Approved
item exists with stock, badge -1", fillcolor="#d1fadf", color="#039855"];
  "StaffStockHasImported" [label="Staff stock search
imported item present", fillcolor="#d1fadf", color="#039855", peripheries=2];
  "DoctorImportCreatesDirectly" [label="Doctor's own opening import
runs immediately, no approval", fillcolor="#d1fadf", color="#039855", peripheries=2];
  "PharmacistSubmitted" [label="Pharmacist add -> sent for approval", fillcolor="#d1fadf", color="#039855", peripheries=2];
  "DoctorStockPending" [label="Doctor stock search
item absent, badge = pending", fillcolor="#d1fadf", color="#039855"];
  "DoctorNewItemsPending" [label="Doctor 'New items' tab
request with all details", fillcolor="#d1fadf", color="#039855"];
  "RejectDialog" [label="Reject dialog
no note: Reject disabled", fillcolor="#d1fadf", color="#039855"];
  "RejectReady" [label="Reject dialog with note
Reject enabled", fillcolor="#d1fadf", color="#039855"];
  "DoctorRejected" [label="Doctor: Rejected with note
0 items, badge -1", fillcolor="#d1fadf", color="#039855"];
  "StaffSeesRejected" [label="Staff sees Rejected
reviewer + note, 0 items", fillcolor="#d1fadf", color="#039855", peripheries=2];
  "ApproveDialog" [label="Approve dialog open", fillcolor="#d1fadf", color="#039855"];
  "DoctorApproved" [label="Doctor: Approved
exactly 1 item, badge -1", fillcolor="#d1fadf", color="#039855"];
  "StaleApproveDialog" [label="Doctor A dialog open
Doctor B already approved", fillcolor="#d1fadf", color="#039855"];
  "ApproveConflict" [label="Doctor A: dialog closed,
'already approved' announced,
still exactly 1 item", fillcolor="#d1fadf", color="#039855"];
  "DoctorStockHasItem" [label="Doctor stock search
item present", fillcolor="#d1fadf", color="#039855"];
  "StaffStockHasItem" [label="Staff stock search
item present", fillcolor="#d1fadf", color="#039855"];
  "StaffSeesApproved" [label="Staff sees Approved
by doctor", fillcolor="#d1fadf", color="#039855", peripheries=2];
  "DoctorAddedDirect" [label="Doctor adds item directly
no request, 1 item", fillcolor="#d1fadf", color="#039855", peripheries=2];
  "StaffStock" -> "StaffAddForm" [label="openAdd ×6", color="#039855", fontcolor="#039855", style=solid];
  "StaffAddForm" -> "StaffDuplicateSku" [label="submitDuplicateSku", color="#039855", fontcolor="#039855", style=solid];
  "StaffDuplicateSku" -> "StaffSubmitted" [label="fixSkuAndSubmit", color="#039855", fontcolor="#039855", style=solid];
  "StaffAddForm" -> "StaffSubmitted" [label="submitFullDetails ×4", color="#039855", fontcolor="#039855", style=solid];
  "StaffAddForm" -> "StaffDuplicateNameSubmitted" [label="submitDuplicateName", color="#039855", fontcolor="#039855", style=solid];
  "StaffDuplicateNameSubmitted" -> "DoctorSeesDuplicateWarning" [label="doctorOpensDuplicateRequest", color="#039855", fontcolor="#039855", style=solid];
  "DoctorSeesDuplicateWarning" -> "DoctorSeesSkuCollision" [label="otherRequestTakesSku", color="#039855", fontcolor="#039855", style=solid];
  "StaffSubmitted" -> "StaffStockPending" [label="closeAndSearch ×5", color="#039855", fontcolor="#039855", style=solid];
  "StaffStockPending" -> "StaffRequestsPending" [label="openMyRequests ×5", color="#039855", fontcolor="#039855", style=solid];
  "StaffRequestsPending" -> "StaffRequestsPending" [label="reload", color="#039855", fontcolor="#039855", style=solid];
  "StaffRequestsPending" -> "StaffApproveForbidden" [label="staffApproveViaApi", color="#039855", fontcolor="#039855", style=solid];
  "StaffApproveForbidden" -> "StaffRequestsPending" [label="reload", color="#039855", fontcolor="#039855", style=solid];
  "StaffStock" -> "StaffImportPending" [label="staffImportExcel ×2", color="#039855", fontcolor="#039855", style=solid];
  "StaffImportPending" -> "DoctorSeesPendingImport" [label="doctorReviewsImport ×2", color="#039855", fontcolor="#039855", style=solid];
  "DoctorSeesPendingImport" -> "ImportRejectDialog" [label="clickRejectImport", color="#039855", fontcolor="#039855", style=solid];
  "ImportRejectDialog" -> "DoctorRejectedImport" [label="confirmImportReject", color="#039855", fontcolor="#039855", style=solid];
  "DoctorRejectedImport" -> "StaffSeesImportRejected" [label="staffOpensMyImports", color="#039855", fontcolor="#039855", style=solid];
  "DoctorSeesPendingImport" -> "DoctorApprovedImport" [label="approveImport", color="#039855", fontcolor="#039855", style=solid];
  "DoctorApprovedImport" -> "StaffStockHasImported" [label="staffLoginAndSearch", color="#039855", fontcolor="#039855", style=solid];
  "StaffStock" -> "DoctorImportCreatesDirectly" [label="doctorImportsExcel", color="#039855", fontcolor="#039855", style=solid];
  "StaffStock" -> "PharmacistSubmitted" [label="pharmacistSubmits", color="#039855", fontcolor="#039855", style=solid];
  "StaffStock" -> "DoctorAddedDirect" [label="doctorAddsDirect", color="#039855", fontcolor="#039855", style=solid];
  "StaffRequestsPending" -> "DoctorStockPending" [label="doctorLoginAndSearch ×5", color="#039855", fontcolor="#039855", style=solid];
  "DoctorStockPending" -> "DoctorNewItemsPending" [label="openApprovals ×5", color="#039855", fontcolor="#039855", style=solid];
  "DoctorNewItemsPending" -> "RejectDialog" [label="clickReject ×2", color="#039855", fontcolor="#039855", style=solid];
  "RejectDialog" -> "RejectDialog" [label="typeBlankNote", color="#039855", fontcolor="#039855", style=solid];
  "RejectDialog" -> "RejectReady" [label="typeNote ×2", color="#039855", fontcolor="#039855", style=solid];
  "RejectReady" -> "DoctorRejected" [label="confirmReject ×2", color="#039855", fontcolor="#039855", style=solid];
  "DoctorRejected" -> "StaffSeesRejected" [label="staffLoginAndOpenRequests", color="#039855", fontcolor="#039855", style=solid];
  "DoctorNewItemsPending" -> "ApproveDialog" [label="clickApprove ×4", color="#039855", fontcolor="#039855", style=solid];
  "ApproveDialog" -> "DoctorNewItemsPending" [label="cancel", color="#039855", fontcolor="#039855", style=solid];
  "ApproveDialog" -> "DoctorApproved" [label="confirmApprove", color="#039855", fontcolor="#039855", style=solid];
  "ApproveDialog" -> "DoctorApproved" [label="doubleClickApprove", color="#039855", fontcolor="#039855", style=solid];
  "ApproveDialog" -> "StaleApproveDialog" [label="secondDoctorApproves", color="#039855", fontcolor="#039855", style=solid];
  "StaleApproveDialog" -> "ApproveConflict" [label="confirmApprove", color="#039855", fontcolor="#039855", style=solid];
  "DoctorApproved" -> "DoctorApproved" [label="reload", color="#039855", fontcolor="#039855", style=solid];
  "DoctorApproved" -> "DoctorStockHasItem" [label="doctorSearchStock", color="#039855", fontcolor="#039855", style=solid];
  "DoctorStockHasItem" -> "StaffStockHasItem" [label="staffLoginAndSearch", color="#039855", fontcolor="#039855", style=solid];
  "StaffStockHasItem" -> "StaffSeesApproved" [label="openMyRequests", color="#039855", fontcolor="#039855", style=solid];
}