digraph "cr21-visit-identity" {
  graph [rankdir=LR, fontname="Helvetica", fontsize=13, labelloc=t, label="CR-21: patient identity stays visible on Visit Documentation\nstates 15/16 (94%) · transitions 16/17 (94%)", pad=0.3, nodesep=0.45, ranksep=0.7];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, penwidth=1.6];
  edge [fontname="Helvetica", fontsize=9, penwidth=1.4, arrowsize=0.7];
  __start [shape=point, width=0.15, label=""];
  __start -> "SetupEmpty";
  "SetupEmpty" [label="Visits setup, no patient selected", fillcolor="#d1fadf", color="#039855"];
  "SetupReady" [label="Setup: new patient picked by search, ready card shows identity", fillcolor="#d1fadf", color="#039855"];
  "FreshOpen" [label="Visit #1 of new patient, Patient Context open", fillcolor="#d1fadf", color="#039855"];
  "FreshCollapsed" [label="Visit #1, Patient Context collapsed", fillcolor="#d1fadf", color="#039855"];
  "FreshRxScrolled" [label="Visit #1 collapsed, Treatment/Rx scrolled into view", fillcolor="#d1fadf", color="#039855"];
  "FreshTabsScrolled" [label="Visit #1 collapsed, every scrolling tab scrolled to bottom", fillcolor="#d1fadf", color="#039855"];
  "FreshOpenSaveReached" [label="Visit #1, context open, scrolled to the Rx Save Draft button", fillcolor="#fee4e2", color="#d92d20"];
  "FreshCollapsedSaveReached" [label="Visit #1, context collapsed, scrolled to the Rx Save Draft button", fillcolor="#d1fadf", color="#039855"];
  "ApptOpen" [label="Visit from appointment (slot + OPD), context open", fillcolor="#d1fadf", color="#039855"];
  "ApptCollapsed" [label="Appointment visit, context collapsed", fillcolor="#d1fadf", color="#039855"];
  "ApptRxScrolled" [label="Appointment visit collapsed, Rx scrolled into view", fillcolor="#d1fadf", color="#039855"];
  "DobOpen" [label="Patient whose age comes from dob only, context open", fillcolor="#d1fadf", color="#039855"];
  "DobCollapsed" [label="Dob-only patient, context collapsed", fillcolor="#d1fadf", color="#039855"];
  "ResumeOpen" [label="Existing visit resumed by ?visitId (later visit, other doctor)", fillcolor="#d1fadf", color="#039855"];
  "ResumeCollapsed" [label="Resumed visit, context collapsed", fillcolor="#d1fadf", color="#039855"];
  "ResumeRxScrolled" [label="Resumed visit collapsed, Rx scrolled into view", fillcolor="#d1fadf", color="#039855"];
  "SetupEmpty" -> "SetupReady" [label="searchAndPickPatient ×3", color="#039855", fontcolor="#039855", style=solid];
  "SetupReady" -> "FreshOpen" [label="startVisit ×3", color="#039855", fontcolor="#039855", style=solid];
  "FreshOpen" -> "FreshCollapsed" [label="collapseContext ×3", color="#039855", fontcolor="#039855", style=solid];
  "FreshCollapsed" -> "FreshOpen" [label="expandContext", color="#039855", fontcolor="#039855", style=solid];
  "FreshCollapsed" -> "FreshRxScrolled" [label="scrollToRx", color="#039855", fontcolor="#039855", style=solid];
  "FreshOpen" -> "FreshOpenSaveReached" [label="scrollToRxSaveButton", color="#d92d20", fontcolor="#d92d20", style=solid];
  "FreshCollapsed" -> "FreshCollapsedSaveReached" [label="scrollToRxSaveButton", color="#039855", fontcolor="#039855", style=solid];
  "FreshRxScrolled" -> "FreshTabsScrolled" [label="scrollEveryTab", color="#039855", fontcolor="#039855", style=solid];
  "FreshTabsScrolled" -> "ApptOpen" [label="openAppointmentVisit", color="#039855", fontcolor="#039855", style=solid];
  "ApptOpen" -> "ApptCollapsed" [label="collapseContext ×2", color="#039855", fontcolor="#039855", style=solid];
  "ApptCollapsed" -> "ApptOpen" [label="expandContext", color="#039855", fontcolor="#039855", style=solid];
  "ApptCollapsed" -> "ApptRxScrolled" [label="scrollToRx", color="#039855", fontcolor="#039855", style=solid];
  "ApptRxScrolled" -> "DobOpen" [label="openDobOnlyVisit", color="#039855", fontcolor="#039855", style=solid];
  "DobOpen" -> "DobCollapsed" [label="collapseContext", color="#039855", fontcolor="#039855", style=solid];
  "DobCollapsed" -> "ResumeOpen" [label="resumeVisitById", color="#039855", fontcolor="#039855", style=solid];
  "ResumeOpen" -> "ResumeCollapsed" [label="collapseContext", color="#039855", fontcolor="#039855", style=solid];
  "ResumeCollapsed" -> "ResumeRxScrolled" [label="scrollToRx", color="#039855", fontcolor="#039855", style=solid];
}