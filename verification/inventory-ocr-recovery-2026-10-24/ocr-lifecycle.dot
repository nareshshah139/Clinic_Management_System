digraph OCR {
 graph [rankdir=TB,bgcolor="#f8fafc",pad=.35,nodesep=.4,ranksep=.55,fontname="Helvetica",fontsize=18,labelloc=t,label="OCR: evidence-based admission or safe rejection"];
 node [shape=box,style="rounded,filled",fillcolor="#e2e8f0",color="#94a3b8",fontname="Helvetica",fontsize=13];
 edge [fontname="Helvetica",fontsize=11,color="#475569"];
 upload [label="Validate upload\nArchive accepted originals"];
 scan [label="Extract ALL pages\nNo silent truncation"];
 invalid [label="Missing / unreadable / over-limit pages\nNo partial intake",fillcolor="#fef3c7"];
 review [label="Low confidence · disagreeing reads\nUnknown identity · totals mismatch\nManual correction + evidence",fillcolor="#fef3c7"];
 manual [label="Full manual entry\nBlank fields; original retained",fillcolor="#dbeafe"];
 draft [label="Current saved invoice\nReview and validation"];
 stock [label="Commit exact invoice once\nNo duplicate receipt",fillcolor="#d1fae5"];
 verified [label="Verified inventory\nPhysical count + independent checkpoint",fillcolor="#d1fae5"];
 rejected [label="Safe rejection\nRetain accepted originals + history\nUnposted invoice: reason + revision + audit",fillcolor="#fee2e2"];
 upload -> scan [label="All pages supported"];
 upload -> rejected [label="Invalid format / size"];
 scan -> invalid [label="Cannot establish completeness"];
 scan -> review [label="Flags or uncertainty"];
 scan -> draft [label="Validated reading"];
 invalid -> manual [label="Complete original available"];
 invalid -> rejected [label="Evidence unavailable / reject"];
 review -> draft [label="Correct + revalidate"];
 review -> rejected [label="Reject unposted invoice"];
 manual -> draft [label="Type every row + verify"];
 manual -> rejected;
 draft -> stock [label="Review + guards + atomic commit"];
 draft -> rejected [label="Current revision; unposted only"];
 stock -> verified [label="Use inventory reconciliation\nif physical/ledger mismatch"];
}
