---
title: "Clinic bill payments (code)"
---
stateDiagram-v2
  state "Money due" as s0
  state "Bill wrong: a payment is refunded twice" as s1
  state "Card or UPI payment waiting for confirmation" as s2
  state "Paid in full" as s3
  [*] --> s0
  s0 --> s1: the admin refunds a payment
  s0 --> s2: the desk starts a card or UPI payment
  s0 --> s3: the admin saves an edited bill / the desk takes a payment
  s2 --> s0: the desk confirms the card or UPI payment
  s2 --> s3: the desk confirms the card or UPI payment
  s3 --> s0: the admin refunds a payment / the admin saves an edited bill
  s3 --> s1: the admin refunds a payment
  classDef breaks fill:#fde2dd,stroke:#b3261e,stroke-width:2px
  classDef stuck fill:#fdf0d5,stroke:#a35a05,stroke-width:2px,stroke-dasharray:5 3
  classDef breaksAndStuck fill:#fde2dd,stroke:#a35a05,stroke-width:2px,stroke-dasharray:5 3
  class s1 breaks
  class s2 stuck
