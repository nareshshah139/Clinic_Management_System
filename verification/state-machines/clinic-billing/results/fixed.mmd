---
title: "Clinic bill payments (fixed)"
---
stateDiagram-v2
  state "Money due" as s0
  state "Card or UPI payment waiting for confirmation" as s1
  state "Paid in full" as s2
  [*] --> s0
  s0 --> s1: the desk starts a card or UPI payment
  s0 --> s2: the admin saves an edited bill / the desk takes a payment
  s1 --> s0: the desk confirms the card or UPI payment / the system closes an unconfirmed payment
  s1 --> s2: the desk confirms the card or UPI payment / the system closes an unconfirmed payment
  s2 --> s0: the admin refunds a payment / the admin saves an edited bill
  classDef breaks fill:#fde2dd,stroke:#b3261e,stroke-width:2px
  classDef stuck fill:#fdf0d5,stroke:#a35a05,stroke-width:2px,stroke-dasharray:5 3
  classDef breaksAndStuck fill:#fde2dd,stroke:#a35a05,stroke-width:2px,stroke-dasharray:5 3
