---
title: "Dictation and voice capture (before)"
---
stateDiagram-v2
  state "Opening the live preview" as s0
  state "Dictation ended" as s1
  state "Listening with live preview" as s2
  state "Listening, recording only" as s3
  state "Waiting for the server's transcript" as s4
  state "Finishing the live transcript" as s5
  state "Live preview kept a failed piece" as s6
  state "Voice bar working it out" as s7
  [*] --> s0
  s0 --> s1: the server answers the live offer / you discard or leave the page
  s0 --> s2: the live channel opens
  s0 --> s3: the 10 second connect timer fires / the live channel drops / the server answers the live offer
  s0 --> s4: the 10 minute cap stops it / you press stop
  s2 --> s1: you discard or leave the page
  s2 --> s3: OpenAI reports an error / the live channel drops
  s2 --> s5: the 10 minute cap stops it / you press stop
  s2 --> s6: OpenAI completes a piece
  s3 --> s1: you discard or leave the page
  s3 --> s4: the 10 minute cap stops it / you press stop
  s4 --> s1: the server splits the speakers / the server transcribes the recording / you discard or leave the page
  s4 --> s7: the server transcribes the recording
  s5 --> s1: you discard or leave the page
  s5 --> s4: OpenAI completes a piece / OpenAI confirms the last words / OpenAI fails a piece / OpenAI reports an error / the 8 second finish timer fires / the live channel drops
  s5 --> s6: OpenAI completes a piece
  s5 --> s7: OpenAI completes a piece / OpenAI confirms the last words
  s7 --> s1: the 240 second abort fires / voice fill answers
  classDef breaks fill:#fde2dd,stroke:#b3261e,stroke-width:2px
  classDef stuck fill:#fdf0d5,stroke:#a35a05,stroke-width:2px,stroke-dasharray:5 3
  classDef breaksAndStuck fill:#fde2dd,stroke:#a35a05,stroke-width:2px,stroke-dasharray:5 3
  class s6 breaks
  class s4 stuck
