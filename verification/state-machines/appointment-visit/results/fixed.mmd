---
title: "Appointment and its visit (fixed)"
---
stateDiagram-v2
  state "Waiting, no visit" as s0
  state "Cancelled" as s1
  state "Visit open" as s2
  state "Visit completed" as s3
  [*] --> s0
  s0 --> s1: an admin bulk-updates the status / the desk cancels / the desk edits the status
  s0 --> s2: the doctor starts the visit
  s1 --> s0: an admin bulk-updates the status / the desk edits the status
  s2 --> s0: the visit is deleted
  s2 --> s3: the doctor completes the visit
  s3 --> s0: the visit is deleted
  classDef breaks fill:#fde2dd,stroke:#b3261e,stroke-width:2px
  classDef stuck fill:#fdf0d5,stroke:#a35a05,stroke-width:2px,stroke-dasharray:5 3
