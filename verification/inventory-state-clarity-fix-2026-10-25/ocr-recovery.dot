digraph ocr {
rankdir=LR; graph [fontname="Arial",bgcolor="white",label="OCR recovery and safe rejection paths",labelloc=t]; node [shape=box,style="rounded,filled",fillcolor="#edf3ff",fontname="Arial",fontsize=10]; edge [fontname="Arial",fontsize=9];
"RUNNING_NO_HISTORY" [label="Running No History"];
