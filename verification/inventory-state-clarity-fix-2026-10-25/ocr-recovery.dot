"REVIEWED_LINKED_RECEIPT" -> "COMMITTED" [label="Post bill; no additional stock"];
"REVIEWED_LINKED_RECEIPT" -> "DRAFT_REVIEW" [label="Reopen review"];
"DUPLICATE_DRAFT" -> "DRAFT_REVIEW" [label="Open exact existing unposted invoice and compare retained entry"];
"DUPLICATE_COMMITTED" -> "COMMITTED" [label="Open exact existing committed invoice; do not add stock again"];
"STALE_DRAFT" -> "DRAFT_REVIEW" [label="Compare with authoritative unposted saved version"];
"STALE_COMMITTED" -> "COMMITTED" [label="Open authoritative committed outcome"];
"UNKNOWN_NO_HISTORY" -> "DELEGATED_NO_HISTORY" [label="Open retained recovery reference"];
"DELEGATED_NO_HISTORY" -> "NO_STOCK_WRITTEN" [label="Recover import outcome with no_history"];
"UNKNOWN_EXACT_DRAFT" -> "DELEGATED_EXACT_DRAFT" [label="Open retained recovery reference"];
