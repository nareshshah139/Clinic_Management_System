"REVIEWED_LINKED_RECEIPT" [label="Ready to Post bill: stock received earlier"];
"DUPLICATE_DRAFT" [label="Duplicate Draft"];
"DUPLICATE_COMMITTED" [label="Duplicate Committed"];
"STALE_DRAFT" [label="Stale Draft"];
"STALE_COMMITTED" [label="Stale Committed"];
"NO_STOCK_WRITTEN" [label="Stopped safely: no invoice or stock from this attempt"];
"RETRY_REJECTED" [label="Retry rejected: historical stock remains unverified"];
"COMMITTED" [label="Confirmed saved outcome"];
"CANCELLED" [label="Unposted intake rejected: retain originals and history"];
"UNKNOWN_NO_HISTORY" [label="Unknown No History"];
"UNKNOWN_EXACT_DRAFT" [label="Unknown Exact Draft"];
"UNKNOWN_EXACT_COMMITTED" [label="Unknown Exact Committed"];
"UNKNOWN_MISSING_LINK" [label="Unknown Missing Link"];
"UNKNOWN_CONFLICTING_LINKS" [label="Unknown Conflicting Links"];
"UNKNOWN_LOST_SOURCE" [label="Unknown Lost Source"];
"DELEGATED_NO_HISTORY" [label="Delegated No History"];
"DELEGATED_EXACT_DRAFT" [label="Delegated Exact Draft"];
"DELEGATED_EXACT_COMMITTED" [label="Delegated Exact Committed"];
"DELEGATED_MISSING_LINK" [label="Delegated Missing Link"];
"DELEGATED_CONFLICTING_LINKS" [label="Delegated Conflicting Links"];
"DELEGATED_LOST_SOURCE" [label="Delegated Lost Source"];
"MISSING_DIRECT_URL" -> "MISSING_RETAINED" [label="Initial read failure retains exact invoice"];
"RUNNING_NO_HISTORY" -> "NO_STOCK_WRITTEN" [label="Resolve interrupted import"];
"ABSENT_ATTRIBUTED" -> "NO_STOCK_WRITTEN" [label="Resolve original attempt"];
"RUNNING_NO_HISTORY" -> "DELEGATED_NO_HISTORY" [label="Open or copy recovery handoff"];
"ABSENT_ATTRIBUTED" -> "DELEGATED_NO_HISTORY" [label="Retain original operator reference"];
"MISSING_RETAINED" -> "DELEGATED_MISSING_LINK" [label="Open exact recovery reference"];
"LEGACY_RETAINED" -> "RETRY_REJECTED" [label="Recover legacy or missing invoice"];
"MISSING_RETAINED" -> "RETRY_REJECTED" [label="Recover legacy or missing invoice"];
"DRAFT_REVIEW" -> "REVIEWED" [label="Review complete original"];
"DRAFT_REVIEW" -> "CANCELLED" [label="Reject unposted invoice"];
"REVIEWED" -> "COMMITTED" [label="Add to stock"];
"REVIEWED" -> "DRAFT_REVIEW" [label="Reopen review"];
"INCOMPLETE_PAGES" -> "DRAFT_REVIEW" [label="Enter complete invoice manually"];
