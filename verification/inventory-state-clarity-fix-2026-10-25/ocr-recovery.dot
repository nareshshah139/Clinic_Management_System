"UNKNOWN_CONFLICTING_LINKS" -> "DELEGATED_CONFLICTING_LINKS" [label="Open retained recovery reference"];
"DELEGATED_CONFLICTING_LINKS" -> "RETRY_REJECTED" [label="Recover import outcome with conflicting_links"];
"UNKNOWN_LOST_SOURCE" -> "DELEGATED_LOST_SOURCE" [label="Open retained recovery reference"];
"DELEGATED_LOST_SOURCE" -> "RETRY_REJECTED" [label="Recover import outcome with lost_source"];
}
